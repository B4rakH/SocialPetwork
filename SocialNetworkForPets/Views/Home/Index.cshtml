@using SocialNetworkForPets.Data.Models;

@model List<Post>


<main id="site__main" class="2xl:ml-[--w-side]  xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">
    <div class="lg:flex 2xl:gap-16 gap-12 max-w-[1065px] mx-auto" id="js-oversized">
        <div class="max-w-[680px] mx-auto">

            <div class="md:max-w-[580px] mx-auto flex-1 xl:space-y-6 space-y-3">



                @*Create Post*@
                <div class="bg-white rounded-xl shadow-sm md:p-4 p-2 space-y-4 text-sm font-medium border1">
                    <div class="flex items-center md:gap-3 gap-1">

                        <div class="flex-1 bg-slate-100 hover:bg-opacity-80 transition-all rounded-lg cursor-pointer"
                             uk-toggle="target: #create-status">

                            <div class="py-2.5 text-center">What do you want to post?</div>
                        </div>
                        <div class="cursor-pointer hover:bg-opacity-80 p-1 px-1.5 rounded-xl transition-all bg-blue-100/60 hover:bg-blue-100"
                             uk-toggle="target: #create-status">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 stroke-pink-600 fill-pink-200/70" viewBox="0 0 24 24" stroke-width="1.5" stroke="#2c3e50" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M15 8h.01" />
                                <path d="M12 3c7.2 0 9 1.8 9 9s-1.8 9 -9 9s-9 -1.8 -9 -9s1.8 -9 9 -9z" />
                                <path d="M3.5 15.5l4.5 -4.5c.928 -.893 2.072 -.893 3 0l5 5" />
                                <path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l2.5 2.5" />
                            </svg>
                        </div>

                        <div></div>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-sm md:p-4 p-2 space-y-4 text-sm font-medium border1" style="width: 580px;">

                    Currently, there are no posts available. Would you like to create the first one?

                </div>


                <div class="bg-white rounded-xl shadow-sm md:p-4 p-2 space-y-4 text-sm font-medium border1">

                    @*Post Heading*@
                    <div class="flex gap-3 sm:p-4 p-2.5 text-sm font-medium">
                        @*User Profile Pic*@
                        <a>
                            <img src="~/images/avatar/user.png" class="w-9 h-9 rounded-full" />
                        </a>
                        @*Post Date*@
                        <div class="flex-1">
                            <a>
                                <h4 class="text-black">User</h4>
                                <div class="text-xs text-gray-500/80"> POST_DATE </div>
                            </a>
                        </div>
                        @*Post Settings (...)*@
                        <div class="-mr-1">
                            <button type="button" class="button-icon w-8 h-8"> <ion-icon class="text-xl" name="ellipsis-horizontal"></ion-icon> </button>
                            <div class="w-[245px] post-options-dropdown" uk-dropdown="pos: bottom-right; animation: uk-animation-scale-up uk-transform-origin-top-right; animate-out: true; mode: click">
                                <form>
                                    <button type="button" class="text-red-400 hover:!bg-red-50 delete-post-btn">
                                        <ion-icon name="trash-bin-outline"></ion-icon>  Delete Post
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                    @*Post Content*@
                    <a>
                        <div class="sm:px-4 p-2.5 pt-0 w-full">
                            <p class="font-normal">
                                Share Something!
                            </p>
                        </div>
                    </a>

                    <a>
                        <div class="w-full lg\:h-96 h-full sm:px-4">
                            <img src="../images/placeholders/post-placeholder.jpg"
                                 class="sm:rounded-lg w-full h-full object-cover" />
                        </div>
                    </a>
                    @*Icons*@

                    @*Like İcon*@
                    <div class="sm:p-4 p-2.5 flex items-center gap-4 text-xs font-semibold">
                        <div>
                            <div class="flex items-center gap-2.5">
                                <a class="button-icon text-red-500">
                                    <ion-icon class="text-lg" name="heart"></ion-icon>
                                </a>
                                <a href="#">0</a>
                            </div>
                        </div>
                        @*Comment İcon*@
                        <div class="flex items-center gap-3">
                            <a class="button-icon">
                                <ion-icon class="text-lg" name="chatbubble-ellipses-outline"></ion-icon>
                            </a>
                            <a href="#">0</a>
                        </div>
                    </div>
                    @*Add Comment Sect*@
                    <div>
                        <div class="sm:px-4 sm:py-3 p-2.5 border-t border-gray-100 flex items-center gap-1">
                            <img src="../images/avatar/user.png" class="w-6 h-6 rounded-full" />

                            <div class="flex-1 relative overflow-hidden h-10">
                                <textarea name="content" placeholder="Add Comment...."
                                          rows="1"
                                          class="w-full resize-none !bg-transparent px-4 py-2 focus:!border-transparent focus:!ring-transparent"></textarea>
                            </div>
                            <button type="submit" class="text-sm rounded-full py-1.5 px-3.5 bg-secondery">
                                Comment

                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="flex-1">
            <div class="lg\:space-y-4 lg\:pb-8 max-lg:grid sm:grid-cols-2 max-lg:gap-6">
                @*Reccomended People*@
                <div class="box p-5 px-6">
                    <partial name="Sidebar/_SuggestedPeoples" />
                </div>
                @*Trend Topics*@
                <div class="box p-5 px-6 border1">
                    <partial name="Sidebar/_TrendTopics" />
                </div>
            </div>
        </div>
    </div>
</main>
<partial name="Modals/_CreatePost" />