@using System.Security.Claims
@model Post

@{
    TimeSpan timeSpanSincePosted = DateTime.UtcNow.Subtract(Model.CreatedAt);

    string displayTime = timeSpanSincePosted switch
    {
        //If CreatedAt >= 24 hour
        var t when t.TotalDays >= 1 => $"{(int)t.TotalDays} day ago",
        //If CreatedAt >= 60 minute
        var t when t.TotalHours >= 1 => $"{(int)t.TotalHours} hour ago",
        //If CreatedAt >= 60 seconds
        var t when t.TotalMinutes >= 1 => $"{(int)t.TotalMinutes} min ago",
        //Else
        _ => "Just now"
    };
    var UserId = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out int Id) ? Id : 0;

    var UserImgUrl = User.FindFirstValue(CustomClaim.UserImgUrl);

    var isAdmin = User.IsInRole(UserRank.Admin);

    bool isLiked = Model.Likes.Any(u => u.UserId == UserId);
    bool isFavorited = Model.Favorites.Any(u => u.UserId == UserId);
    bool isReported = Model.Reports.Any(n => n.UserId == UserId);

    bool showAllComments = ViewData["ShowAllComment"] as bool? ?? false;
    bool showDetails = ViewData["ShowDetails"] as bool? ?? true;
}

<div id="post-@Model.PostId" class="bg-white rounded-xl shadow-sm text-sm font-medium">

    @*Post Heading*@
    <div class="flex gap-3 sm:p-4 p-2.5 text-sm font-medium">
        @*User Profile Pic*@
        <a asp-controller="Users" asp-action="Details" asp-route-userId=@Model.PosterId>
            @if (string.IsNullOrEmpty(Model.Poster.UserImgUrl))
            {
                <img src="@Url.Content("~/images/avatar/avatar.png")" class="w-10 h-10 rounded-full" />
            }
            else
            {
                <img src=@Model.Poster.UserImgUrl class="w-10 h-10 rounded-full" />
            }
        </a>
        @*Post Date*@
        <div class="flex-1">
            <a asp-controller="Users" asp-action="Details" asp-route-userId=@Model.PosterId>
                <h4 class="text-black">@Model.Poster.UserFullName</h4>
                <div class="text-xs text-gray-500/80">@displayTime</div>
            </a>
        </div>
        @*Post Settings (...)*@
        <div class="-mr-1">
            <button type="button" class="button-icon w-8 h-8"> <ion-icon class="text-xl" name="ellipsis-horizontal"></ion-icon> </button>
            <div class="w-[245px] post-options-dropdown" uk-dropdown="pos: bottom-right; animation: uk-animation-scale-up uk-transform-origin-top-right; animate-out: true; mode: click">

                @if (Model.PosterId == UserId || isAdmin)
                {
                    <form asp-controller="Home" asp-action="RemovePost">
                        <input type="hidden" name="PostId" value="@Model.PostId" />
                        <button type="submit" class="text-red-400 hover:!bg-red-50 delete-post-btn">
                            <ion-icon name="trash-bin-outline"></ion-icon>  Delete Post
                        </button>
                    </form>
                }
                @if (!isReported)
                {
                    <form asp-controller="Home" asp-action="AddPostReport">
                        <input type="hidden" name="PostId" value="@Model.PostId" />
                        <button type="submit" class="hover:!bg-red-50 icon-link">
                            <ion-icon class="text-xl shrink-0" name="flag"></ion-icon>Report
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
    @*Post Content*@
    <a>
        <div class="sm:px-4 p-2.5 pt-0 w-full">
            <p class="font-normal">
                @Model.PostText
            </p>
        </div>
    </a>
    @if (!string.IsNullOrEmpty(Model.PostImgUrl))
    {
        <a>
            <div class="w-full lg:h-96 h-full sm:px-4">
                <img src="@Model.PostImgUrl"
                     class="sm:rounded-lg w-full h-full object-cover" />
            </div>
        </a>
    }

    @*Likes*@
    <div class="sm:p-4 p-2.5 flex items-center gap-4 text-xs font-semibold">
        <div>
            <div class="flex items-center gap-2.5">
                <form asp-controller="Home" asp-action="TogglePostLike">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PostId" value="@Model.PostId" />
                    <button type="submit" class="button-icon like-button @(isLiked ? "text-red-500 bg-red-100" : "")">
                        <ion-icon class="text-lg" name="@(isLiked ? "heart" : "heart-outline" )"></ion-icon>
                    </button>
                </form>
                <a href="#">@Model.Likes.Count</a>
            </div>
        </div>
        @*Comment İcon*@
        <div class="flex items-center gap-3">
            <a class="button-icon" asp-controller="Home" asp-action="Details" asp-route-postId="@Model.PostId">
                <ion-icon class="text-lg" name="chatbubble-ellipses-outline"></ion-icon>
            </a>
            <a href="#">@Model.Comments.Count</a>
        </div>

        <div class="ml-auto"></div>

        <div class="flex items-center gap-2">
            <form asp-controller="Home" asp-action="TogglePostFavorite">
                <input type="hidden" name="PostId" value="@Model.PostId" />
                <button type="submit" class="button-icon favorite-button ml-auto text-blue-500 bt-blue-100">
                    <ion-icon class="text-lg" name="@(isFavorited ? "bookmark" : "bookmark-outline" )"></ion-icon>
                </button>
            </form>
            @if (Model.Favorites.Count > 0)
            {
                <a href="#">@Model.Favorites.Count</a>
            }
        </div>
    </div>


    @if (showDetails)
    {
        @*Comment Sect*@
        <div>
            <div class="p-2.5 border-t border-gray-100 font-normal space-y-3 relative">
                @foreach (var comment in (showAllComments ? Model.Comments : Model.Comments.Take(3)))
                {
                    <div class="flex items-start gap-3 relative">
                        <a asp-controller="Users" asp-action="Details" asp-route-userId=@comment.User.UserId>
                            @if (string.IsNullOrEmpty(comment.User.UserImgUrl))
                            {
                                <img src="@Url.Content("~/images/avatar/avatar.png")" class="w-6 h-6 mt-1 rounded-full" />
                            }
                            else
                            {
                                <img src="@comment.User.UserImgUrl" class="w-6 h-6 mt-1 rounded-full" />
                            }
                        </a>
                        <div class="flex-1">
                            <div class="flex justify-content-between">
                                <a asp-controller="Users" asp-action="Details" asp-route-userId=@comment.User.UserId class="text-black font-medium inline-block flex-grow">
                                    @comment.User.UserFullName
                                </a>
                            </div>
                            <div class="flex items-center justify-between">
                                <p class="mt-0.5">
                                    @comment.CommentText
                                </p>

                                @if (comment.UserId == UserId || Model.PosterId == UserId || isAdmin)
                                {
                                    <form asp-controller="Home" asp-action="DeleteComment" class="remove-comment-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="CommentId" value="@comment.CommentId" />
                                        <input type="hidden" name="PostId" value="@Model.PostId" />
                                        <button type="submit" class="text-red-500 text-xs ml-2" title="Remove post comment">
                                            <ion-icon name="trash-outline"></ion-icon>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
                @if (Model.Comments.Count > 3 && !showAllComments)
                {
                    <div class="p-1.5">
                        <a asp-controller="Home" asp-action="Details" asp-route-postId="@Model.PostId">
                            Show All Comments
                        </a>
                    </div>
                }
            </div>

            <form asp-controller="Home" asp-action="AddComment" class="add-comment-form">
                @Html.AntiForgeryToken()
                <div class="sm:px-4 sm:py-3 p-2.5 border-t border-gray-100 flex items-center gap-1">

                    <a asp-controller="Users" asp-action="Details" asp-route-userId=@Model.PosterId>
                        @if (string.IsNullOrEmpty(UserImgUrl))
                        {
                            <img src="@Url.Content("~/images/avatar/avatar.png")" class="w-6 h-6 rounded-full" />
                        }
                        else
                        {
                            <img src=@UserImgUrl class="w-6 h-6 rounded-full" />
                        }
                    </a>

                    <input type="hidden" name="PostId" value="@Model.PostId" />

                    <div class="flex-1 relative overflow-hidden h-10">
                        <textarea name="CommentText" placeholder="Add Comment..."
                                  rows="1"
                                  class="w-full resize-none !bg-transparent px-4 py-2 focus:!border-transparent focus:!ring-transparent"></textarea>
                    </div>
                    <button type="submit" class="text-sm rounded-full py-1.5 px-3.5 bg-secondery">Comment</button>
                </div>
            </form>
        </div>
    }
</div>