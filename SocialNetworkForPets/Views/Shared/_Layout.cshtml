<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SocialNetworkForPets</title>
    <link href="~/images/favicon.png" rel="icon" type="image/svg" />
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SocialNetworkForPets.styles.css" asp-append-version="true" />
</head>
<body>

    <div id="wrapper">
        @*TopBar*@
        <partial name="Navigation/_TopBar" />

        @*SİdeBar*@
        <partial name="Navigation/_SideBar" />

        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @*Asset scripts*@
    <script src="../wwwroot/js/uikit.min.js"></script>
    <script src="../wwwroot/js/simplebar.js"></script>
    <script src="../wwwroot/js/script.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
